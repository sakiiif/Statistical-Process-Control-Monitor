<Window x:Class="SpcMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="SPC Monitor — Fab Process Control"
        Height="780" Width="1200"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="SPC Monitor" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="  Statistical Process Control for Fab Sensor Data" FontSize="13"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Parameter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="200" ItemsSource="{Binding AvailableParameters}"
                          SelectedItem="{Binding SelectedParameter}" Margin="0,0,20,0"/>

                <Button Content="Establish Baseline (Random)" Command="{Binding EstablishBaselineCommand}"/>
                <Button Content="Establish Baseline (from CSV)" Command="{Binding ImportBaselineCommand}"/>
                <Button Content="▶ Start" Command="{Binding StartCommand}" Background="{StaticResource AccentGreen}"/>
                <Button Content="■ Stop" Command="{Binding StopCommand}" Background="{StaticResource AccentRed}"/>
                <Button Content="⚡ Inject Spike" Command="{Binding SpikeCommand}"/>
                <Button Content="↗ Inject Drift" Command="{Binding DriftCommand}"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
                <Button Content="Reset" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </Border>

        <!-- Chart + Violations -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="8">
                <oxy:PlotView Model="{Binding ChartModel}" Background="Transparent"/>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Violations" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{Binding ViolationCountText}" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Violations}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="40"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="70"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat='F2'}" Width="60"/>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="55"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
